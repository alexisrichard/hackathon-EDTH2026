# Claude Code local settings + runtime state (per-user, not for the repo)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.local

# Node
node_modules/
dist/
build/
.next/

# Data — big binary stuff is regenerable from public sources (S3 is retired), never in git
*.parquet
*.tif
*.tiff
*.zip
*.rar
*.tar.gz
*.nc
*.h5

# Big-data subdirs (regenerable from public sources — see DATA_GUIDE.md) — kept out of git
data/ais/
data/sar/
data/optical/
data/cache/
data/tmp/
data/reference/raw/
data/hrsid_samples/
raw/
# YOLO weights are large in general, BUT the trained HRSID model is preserved in git:
# it's the one artifact that is NOT auto-rebuildable, and S3 (its old home) is retired.
# ~6 MB. (Uses /* so the negation can re-include a file inside an otherwise-ignored dir.)
*.pt
scoring/weights/*
!scoring/weights/yolov8n_hrsid_best.pt

# Auto-generated per-vessel lookup outputs — re-runnable via scripts/reference/
data/reference/equasis/
data/reference/gfw_events/
data/reference/gfw_vessels/

# Small, version-controlled layers (geo/criticality, reference, incidents)
# are intentionally tracked under data/geo/ and data/reference/.

# Large derived layers (>10 MB) — regenerable via scripts/geo/ fetchers
data/geo/emodnet_cables_combined.geojson
data/geo/marine_regions_eez_baltic.geojson
data/geo/ne_ocean_10m.geojson
data/geo/bathymetry_*.nc
data/geo/bathymetry_*.tif
data/geo/osm_buoys.geojson

# Generated demo outputs — re-runnable locally
demo_map_*.html
sar_*.png
comparison_before_after.png
detections_yi_peng3.geojson
*.ipynb

# Notebook checkpoints
.ipynb_checkpoints/

# Logs
*.log

# Claude Code preview launcher (per-user)
.claude/launch.json
data/geo/marine_regions_12nm.geojson

# AIS replay tiles — the full 6-year archive rebuilds from public Danish AIS
# (scripts/ingest/danish_ais.py → build_ais_tracks.py → stitch_tracks.py). Only the
# hero-incident days are committed, so the demo's key moments play with zero rebuild.
frontend/public/data/ais/tracks_*.json
!frontend/public/data/ais/tracks_2022-09-26.json
!frontend/public/data/ais/tracks_2023-10-08.json
!frontend/public/data/ais/tracks_2024-11-17.json
!frontend/public/data/ais/tracks_2024-11-18.json
!frontend/public/data/ais/tracks_2024-12-25.json
!frontend/public/data/ais/tracks_2025-01-26.json
scoring/fleet_validation.json

# Stitched AIS tiles (scripts/ingest/stitch_tracks.py) — what the app + scoring engine
# render. Hero-incident days committed; the rest regenerable. (/* so the negations can
# re-include specific files inside the otherwise-ignored dir.)
frontend/public/data/ais_v2/*
!frontend/public/data/ais_v2/tracks_2022-09-26.json
!frontend/public/data/ais_v2/tracks_2023-10-08.json
!frontend/public/data/ais_v2/tracks_2024-11-17.json
!frontend/public/data/ais_v2/tracks_2024-11-18.json
!frontend/public/data/ais_v2/tracks_2024-12-25.json
!frontend/public/data/ais_v2/tracks_2025-01-26.json
data/reference/vessel_signals.mock.json

# Computer-vision / SAR ship-detection pipeline (HRSID) — large/regenerable artifacts.
# (The trained HRSID model is preserved in git above via the !scoring/weights/...best.pt
# negation; pretrained ultralytics checkpoints are already covered by *.pt above.)
data/hrsid_yolo/
scoring/runs/
# Generated dataset YAML holds a machine-specific absolute path:
scoring/hrsid.yaml
# Detector outputs are regenerable, EXCEPT the committed Nord Stream demo detections.
detections_*.geojson
!detections_nordstream.geojson
