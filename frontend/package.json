{
  "name": "edth2026-cueing-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend data layer (types + typed API client + display encoding) for the Baltic maritime cueing engine. UI components are built day-of; this package hosts the contract the map renders against.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "maplibre-gl": "^4.7.1",
    "deck.gl": "^9.0.30",
    "@deck.gl/react": "^9.0.30",
    "@deck.gl/layers": "^9.0.30",
    "@deck.gl/geo-layers": "^9.0.30",
    "@deck.gl/aggregation-layers": "^9.0.30",
    "@deck.gl/extensions": "^9.0.30",
    "@deck.gl/mapbox": "^9.0.30"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
